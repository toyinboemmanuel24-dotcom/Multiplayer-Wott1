rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Room collection: Accessible by room code to allow seamless multiplayer in iframe/mobile
    match /rooms/{roomId} {
      allow read, write: if true;

      // Private player hand
      match /playerHands/{playerId} {
        allow read, write: if true;
      }

      // Live chat messages
      match /messages/{messageId} {
        allow read, write: if true;
      }

      // WebRTC voice signaling
      match /signals/{signalId} {
        allow read, write: if true;
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
